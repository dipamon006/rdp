name: macOS Desktop + Tailscale + VNC

on:
  workflow_dispatch:
    inputs:
      runner:
        description: "macOS runner (try Intel if Apple Silicon shows a black screen)"
        type: choice
        default: macos-latest
        options:
          - macos-latest
          - macos-15-intel
      sunshine:
        description: "Also start Sunshine (for Moonlight). Apple Silicon only."
        type: boolean
        default: true

permissions:
  actions: read
  contents: read

jobs:
  macos-desktop:
    runs-on: ${{ inputs.runner }}
    timeout-minutes: 350

    steps:
      - name: Record job start time
        shell: bash
        run: echo "JOB_START=$(date +%s)" >> "$GITHUB_ENV"

      - name: Set login password and keep the Mac awake
        shell: bash
        env:
          VNC_PASSWORD: ${{ secrets.VNC_PASSWORD }}
        run: |
          set -Eeuo pipefail
          if [[ -z "$VNC_PASSWORD" ]]; then echo "Missing VNC_PASSWORD secret."; exit 1; fi

          # The desktop is the already logged-in 'runner' user, whose password
          # cannot be changed without the old one. Add a separate admin user
          # 'rdpuser' for admin password prompts instead.
          if ! id rdpuser >/dev/null 2>&1; then
            sudo sysadminctl -addUser rdpuser -fullName "RDP User" \
              -password "$VNC_PASSWORD" -admin
          fi

          # No sleep, no display sleep, no screensaver, no lock-screen password.
          sudo pmset -a sleep 0 displaysleep 0 disksleep 0
          defaults -currentHost write com.apple.screensaver idleTime 0
          defaults write com.apple.screensaver askForPassword -int 0
          sudo defaults write /Library/Preferences/com.apple.screensaver loginWindowIdleTime 0

      - name: Find previous backup
        id: findbackup
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          run_id=$(gh api "repos/${GITHUB_REPOSITORY}/actions/artifacts?name=macos-home-backup&per_page=20" \
            --jq '[.artifacts[] | select(.expired == false)][0].workflow_run.id // empty')
          echo "run_id=${run_id}" >> "$GITHUB_OUTPUT"
          if [[ -n "$run_id" ]]; then echo "Found backup from run ${run_id}"; else echo "No previous backup."; fi

      - name: Download previous backup
        if: steps.findbackup.outputs.run_id != ''
        uses: actions/download-artifact@v5
        with:
          name: macos-home-backup
          run-id: ${{ steps.findbackup.outputs.run_id }}
          github-token: ${{ github.token }}
          path: /tmp/restore

      - name: Restore user folders
        if: steps.findbackup.outputs.run_id != ''
        shell: bash
        env:
          BACKUP_PASSPHRASE: ${{ secrets.BACKUP_PASSPHRASE }}
        run: |
          set -Eeuo pipefail
          if [[ -z "$BACKUP_PASSPHRASE" ]]; then echo "Missing BACKUP_PASSPHRASE; cannot decrypt backup."; exit 1; fi
          openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -pass env:BACKUP_PASSPHRASE \
            -in /tmp/restore/home.tar.gz.enc | tar -xzf - -C /Users/runner
          rm -rf /tmp/restore
          echo "User folders restored."

      - name: Install and connect Tailscale
        shell: bash
        env:
          TAILSCALE_AUTHKEY: ${{ secrets.TAILSCALE_AUTHKEY }}
        run: |
          set -Eeuo pipefail
          brew install tailscale
          sudo mkdir -p /var/lib/tailscale
          sudo nohup "$(brew --prefix)/bin/tailscaled" \
            --state=/var/lib/tailscale/tailscaled.state \
            > /tmp/tailscaled.log 2>&1 &
          sleep 5
          sudo tailscale up --authkey="$TAILSCALE_AUTHKEY" --hostname="mac-${GITHUB_RUN_ID}"
          for i in {1..30}; do
            TS_IP=$(tailscale ip -4 2>/dev/null | head -n1 || true)
            [[ -n "$TS_IP" ]] && break
            sleep 3
          done
          [[ -z "$TS_IP" ]] && { echo "Tailscale failed"; cat /tmp/tailscaled.log; exit 1; }
          echo "TAILSCALE_IP=$TS_IP" >> "$GITHUB_ENV"
          echo "Tailscale IP: $TS_IP"

      - name: Build macVNC server
        shell: bash
        run: |
          set -Eeuo pipefail
          # Apple's Screen Sharing needs MDM to capture the screen on new macOS.
          # macVNC (open source, ScreenCaptureKit) started from this job inherits
          # the runner's screen-recording permission instead.
          brew install libvncserver
          git clone --depth 1 https://github.com/LibVNC/macVNC.git /tmp/macVNC
          # macVNC captures 60 FPS and resends the whole screen each frame.
          # 15 FPS cuts CPU and bandwidth by ~4x; plenty for desktop use.
          sed -i '' 's/CMTimeMake(1, 60)/CMTimeMake(1, 15)/' /tmp/macVNC/src/ScreenCapturer.m
          grep -q 'CMTimeMake(1, 15)' /tmp/macVNC/src/ScreenCapturer.m || echo "WARNING: FPS patch did not apply"
          cmake -S /tmp/macVNC -B /tmp/macVNC/build -DCMAKE_BUILD_TYPE=Release
          cmake --build /tmp/macVNC/build --config Release
          BIN=$(find /tmp/macVNC/build -path '*macVNC.app/Contents/MacOS/macVNC' -type f | head -n1)
          [[ -x "$BIN" ]] || { echo "macVNC build not found"; exit 1; }
          echo "MACVNC_BIN=$BIN" >> "$GITHUB_ENV"

      - name: Start VNC server
        id: vnc
        shell: bash
        env:
          VNC_PASSWORD: ${{ secrets.VNC_PASSWORD }}
        run: |
          set -Eeuo pipefail

          # Allow VNC on port 5900 only from Tailscale addresses.
          printf 'block in proto tcp from any to any port 5900\npass in proto tcp from 100.64.0.0/10 to any port 5900\n' | \
            sudo pfctl -a com.apple/250.vnc-tailscale -f - 2>/dev/null
          sudo pfctl -E 2>/dev/null || true

          # Best effort: grant macVNC screen recording and input control.
          TCC="/Library/Application Support/com.apple.TCC/TCC.db"
          now=$(date +%s)
          for svc in kTCCServiceScreenCapture kTCCServiceAccessibility kTCCServicePostEvent; do
            sudo sqlite3 "$TCC" "INSERT OR REPLACE INTO access VALUES('$svc','$MACVNC_BIN',1,2,4,1,NULL,NULL,0,'UNUSED',NULL,0,$now,NULL,NULL,'UNUSED',$now);" \
              || echo "TCC grant failed for $svc (continuing)"
          done

          caffeinate -u -t 10 &

          start_vnc() {
            nohup "$MACVNC_BIN" -rfbport 5900 -passwd "$VNC_PASSWORD" "$@" \
              > /tmp/macvnc.log 2>&1 &
            disown
          }

          start_vnc
          sleep 5
          if ! pgrep -f "$MACVNC_BIN" >/dev/null; then
            echo "macVNC exited (likely no input permission). Log:"
            cat /tmp/macvnc.log
            echo "Retrying in view-only mode (screen visible, no mouse/keyboard)."
            start_vnc -viewonly
            sleep 5
          fi

          for i in {1..20}; do
            if nc -z -G 3 "$TAILSCALE_IP" 5900 2>/dev/null; then
              echo "VNC is reachable on ${TAILSCALE_IP}:5900"
              echo "started=true" >> "$GITHUB_OUTPUT"
              exit 0
            fi
            sleep 3
          done
          echo "macVNC did not start. Log:"
          cat /tmp/macvnc.log
          exit 1

      - name: Install and start RustDesk
        id: rustdesk
        continue-on-error: true
        shell: bash
        env:
          VNC_PASSWORD: ${{ secrets.VNC_PASSWORD }}
        run: |
          set -Eeuo pipefail
          # RustDesk streams the screen as compressed video (like RDP), so it
          # copes with high latency much better than VNC. Connect directly to
          # the Tailscale IP; no RustDesk servers are involved.
          brew install --cask rustdesk
          APP=/Applications/RustDesk.app/Contents/MacOS
          RUNNER_UID=$(id -u runner)

          # Privacy permissions: screen recording and input control.
          TCC="/Library/Application Support/com.apple.TCC/TCC.db"
          now=$(date +%s)
          for svc in kTCCServiceScreenCapture kTCCServiceAccessibility kTCCServicePostEvent kTCCServiceListenEvent; do
            sudo sqlite3 "$TCC" "INSERT OR REPLACE INTO access VALUES('$svc','com.carriez.rustdesk',0,2,4,1,NULL,NULL,0,'UNUSED',NULL,0,$now,NULL,NULL,'UNUSED',$now);" \
              || echo "TCC grant failed for $svc (continuing)"
          done
          sudo killall tccd 2>/dev/null || true

          # Install RustDesk's root service and per-user agent (what its GUI
          # installer does through a password prompt).
          sudo tee /Library/LaunchDaemons/com.carriez.RustDesk_service.plist > /dev/null <<'EOF'
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0"><dict>
            <key>Label</key><string>com.carriez.RustDesk_service</string>
            <key>AssociatedBundleIdentifiers</key><string>com.carriez.rustdesk</string>
            <key>KeepAlive</key><true/>
            <key>ThrottleInterval</key><integer>1</integer>
            <key>ProgramArguments</key><array><string>/Applications/RustDesk.app/Contents/MacOS/service</string></array>
            <key>RunAtLoad</key><true/>
            <key>WorkingDirectory</key><string>/Applications/RustDesk.app/Contents/MacOS/</string>
            <key>StandardErrorPath</key><string>/var/log/rustdesk_service.err</string>
            <key>StandardOutPath</key><string>/var/log/rustdesk_service.out</string>
          </dict></plist>
          EOF
          sudo tee /Library/LaunchAgents/com.carriez.RustDesk_server.plist > /dev/null <<'EOF'
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0"><dict>
            <key>Label</key><string>com.carriez.RustDesk_server</string>
            <key>AssociatedBundleIdentifiers</key><string>com.carriez.rustdesk</string>
            <key>LimitLoadToSessionType</key><array><string>LoginWindow</string><string>Aqua</string></array>
            <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/><key>AfterInitialDemand</key><false/></dict>
            <key>ThrottleInterval</key><integer>1</integer>
            <key>RunAtLoad</key><true/>
            <key>ProgramArguments</key><array><string>/Applications/RustDesk.app/Contents/MacOS/RustDesk</string><string>--server</string></array>
            <key>WorkingDirectory</key><string>/Applications/RustDesk.app/Contents/MacOS/</string>
            <key>ProcessType</key><string>Interactive</string>
          </dict></plist>
          EOF
          sudo chown root:wheel /Library/LaunchDaemons/com.carriez.RustDesk_service.plist /Library/LaunchAgents/com.carriez.RustDesk_server.plist
          sudo chmod 644 /Library/LaunchDaemons/com.carriez.RustDesk_service.plist /Library/LaunchAgents/com.carriez.RustDesk_server.plist

          sudo launchctl bootstrap system /Library/LaunchDaemons/com.carriez.RustDesk_service.plist \
            || sudo launchctl load -w /Library/LaunchDaemons/com.carriez.RustDesk_service.plist
          sudo launchctl bootstrap "gui/${RUNNER_UID}" /Library/LaunchAgents/com.carriez.RustDesk_server.plist \
            || sudo launchctl asuser "$RUNNER_UID" launchctl load -w /Library/LaunchAgents/com.carriez.RustDesk_server.plist
          sleep 10

          # Direct IP access on 21118 with a permanent password (= VNC_PASSWORD).
          sudo "$APP/RustDesk" --option direct-server Y
          sudo "$APP/RustDesk" --option direct-access-port 21118
          sudo "$APP/RustDesk" --option verification-method use-permanent-password
          sudo "$APP/RustDesk" --option approve-mode password
          sudo "$APP/RustDesk" --password "$VNC_PASSWORD"

          # Allow 21118 only from Tailscale addresses.
          printf 'block in proto tcp from any to any port 21118\npass in proto tcp from 100.64.0.0/10 to any port 21118\n' | \
            sudo pfctl -a com.apple/251.rustdesk-tailscale -f - 2>/dev/null

          for i in {1..20}; do
            if nc -z -G 3 "$TAILSCALE_IP" 21118 2>/dev/null; then
              echo "RustDesk is reachable on ${TAILSCALE_IP}:21118"
              echo "started=true" >> "$GITHUB_OUTPUT"
              exit 0
            fi
            sleep 3
          done
          echo "RustDesk direct port did not open. Logs:"
          sudo tail -n 50 /var/log/rustdesk_service.err /var/log/rustdesk_service.out 2>/dev/null || true
          ls ~/Library/Logs/RustDesk 2>/dev/null && tail -n 50 ~/Library/Logs/RustDesk/server/*.log 2>/dev/null || true
          exit 1

      - name: Install and start Sunshine (Moonlight)
        id: sunshine
        if: inputs.sunshine && inputs.runner == 'macos-latest'
        continue-on-error: true
        shell: bash
        env:
          VNC_PASSWORD: ${{ secrets.VNC_PASSWORD }}
        run: |
          set -Eeuo pipefail
          # Sunshine streams the desktop as low-latency video for the Moonlight
          # client. Prebuilt only for Apple Silicon.
          brew tap LizardByte/homebrew
          brew install sunshine
          SUN="$(brew --prefix)/bin/sunshine"
          CONF_DIR="$HOME/.config/sunshine"
          mkdir -p "$CONF_DIR"

          cat > "$CONF_DIR/sunshine.conf" <<'EOF'
          sunshine_name = github-mac
          # Tailscale addresses (100.64.0.0/10) are not "LAN" to Sunshine.
          origin_web_ui_allowed = wan
          upnp = disabled
          encoder = videotoolbox
          # The virtual Mac may lack a hardware encoder; allow Apple's software one.
          vt_software = allowed
          vt_realtime = enabled
          EOF

          # Web UI login: user 'rdpuser', password = VNC_PASSWORD.
          "$SUN" --creds rdpuser "$VNC_PASSWORD" "$CONF_DIR/sunshine.conf" || true

          # Privacy permissions (started from this job it also inherits them).
          TCC="/Library/Application Support/com.apple.TCC/TCC.db"
          now=$(date +%s)
          REAL=$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$SUN")
          for svc in kTCCServiceScreenCapture kTCCServiceAccessibility kTCCServicePostEvent; do
            sudo sqlite3 "$TCC" "INSERT OR REPLACE INTO access VALUES('$svc','$REAL',1,2,4,1,NULL,NULL,0,'UNUSED',NULL,0,$now,NULL,NULL,'UNUSED',$now);" \
              || echo "TCC grant failed for $svc (continuing)"
          done

          # Sunshine ports, Tailscale only.
          {
            echo 'block in proto { tcp udp } from any to any port { 47984 47989 47990 48010 47998 47999 48000 48002 }'
            echo 'pass in proto { tcp udp } from 100.64.0.0/10 to any port { 47984 47989 47990 48010 47998 47999 48000 48002 }'
          } | sudo pfctl -a com.apple/252.sunshine-tailscale -f - 2>/dev/null

          nohup "$SUN" "$CONF_DIR/sunshine.conf" > /tmp/sunshine.log 2>&1 &
          disown

          for i in {1..30}; do
            if nc -z -G 3 "$TAILSCALE_IP" 47989 2>/dev/null; then
              echo "Sunshine is running."
              echo "started=true" >> "$GITHUB_OUTPUT"
              exit 0
            fi
            sleep 3
          done
          echo "Sunshine did not start. Log:"
          tail -n 80 /tmp/sunshine.log || true
          exit 1

      - name: Diagnostic screenshot
        continue-on-error: true
        shell: bash
        run: |
          sleep 10
          system_profiler SPDisplaysDataType | sed -n '1,30p' || true
          screencapture -x /tmp/screen.png && ls -la /tmp/screen.png

      - name: Upload diagnostic screenshot
        continue-on-error: true
        uses: actions/upload-artifact@v7
        with:
          name: macos-screen-${{ github.run_id }}
          path: /tmp/screen.png
          retention-days: 1
          if-no-files-found: ignore

      - name: Print connection details
        shell: bash
        run: |
          echo "=========================================="
          echo "MACOS DESKTOP READY"
          echo "VNC server : ${TAILSCALE_IP}:5900"
          echo "Desktop    : runner (already logged in)"
          echo "Admin user : rdpuser (password = VNC_PASSWORD) for admin prompts"
          echo "Password   : GitHub secret VNC_PASSWORD"
          echo "=========================================="
          if [[ "${{ steps.rustdesk.outputs.started }}" == "true" ]]; then
            echo "RustDesk   : ${TAILSCALE_IP}  (type the IP into RustDesk's ID box; password = VNC_PASSWORD)"
          else
            echo "RustDesk   : FAILED to start - use VNC below"
          fi
          if [[ "${{ steps.sunshine.outputs.started }}" == "true" ]]; then
            echo "Moonlight  : Add PC manually -> ${TAILSCALE_IP}"
            echo "             Pair: enter the PIN at https://${TAILSCALE_IP}:47990 (user rdpuser, password = VNC_PASSWORD)"
          fi
          echo "VNC (fallback): vncviewer -PreferredEncoding=Tight -AutoSelect=0 -QualityLevel=5 -CompressLevel=6 ${TAILSCALE_IP}:5900"
          echo "To end early with a backup: create a file named END_SESSION on the Desktop."
          echo "Do NOT use Apple menu > Shut Down or Restart: it kills the job before the backup."

      - name: Keep desktop alive
        shell: bash
        run: |
          # Stay up until 330 minutes after job start (20 min left for backup).
          # A file named END_SESSION on the Desktop ends the session early.
          deadline=$(( JOB_START + 330 * 60 ))
          while (( $(date +%s) < deadline )); do
            if [[ -e /Users/runner/Desktop/END_SESSION ]]; then
              rm -f /Users/runner/Desktop/END_SESSION
              echo "END_SESSION found. Starting backup."
              exit 0
            fi
            left=$(( (deadline - $(date +%s)) / 60 ))
            echo "[$(date '+%H:%M:%S')] macOS running — ${left} min left before backup"
            sleep 60
          done

      - name: Create encrypted backup
        id: backup
        if: always() && steps.vnc.outputs.started == 'true'
        shell: bash
        env:
          BACKUP_PASSPHRASE: ${{ secrets.BACKUP_PASSPHRASE }}
        run: |
          set -Eeuo pipefail
          if [[ -z "$BACKUP_PASSPHRASE" ]]; then echo "Missing BACKUP_PASSPHRASE; refusing to upload an unencrypted backup."; exit 1; fi

          # User folders only. The runner home also holds GitHub's tool caches.
          cd /Users/runner
          folders=()
          for d in Desktop Documents Downloads Pictures Movies Music; do
            [[ -d "$d" ]] && folders+=("$d")
          done
          if (( ${#folders[@]} == 0 )); then echo "Nothing to back up."; exit 0; fi

          mkdir -p /tmp/backup
          tar -czf - --exclude='.DS_Store' "${folders[@]}" 2>/dev/null | \
            openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -pass env:BACKUP_PASSPHRASE \
              -out /tmp/backup/home.tar.gz.enc
          echo "Encrypted backup ready: $(du -h /tmp/backup/home.tar.gz.enc | cut -f1)"

      - name: Upload backup
        if: always() && steps.backup.outcome == 'success'
        uses: actions/upload-artifact@v7
        with:
          name: macos-home-backup
          path: /tmp/backup/home.tar.gz.enc
          if-no-files-found: warn
